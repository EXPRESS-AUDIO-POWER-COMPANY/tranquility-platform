# Public frontend configuration
VITE_APP_ENV=development
VITE_SITE_URL=http://localhost:5173

# Pricing remains hidden unless the business has approved the production rules.
VITE_ENABLE_LIVE_PRICING=false

# Supabase (add only when a dedicated Tranquility project is provisioned)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key only. Never place secret or service-role keys in VITE_* variables.
VITE_STRIPE_PUBLISHABLE_KEY=
