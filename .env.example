# Public frontend configuration
VITE_APP_ENV=development
VITE_SITE_URL=http://localhost:5173

# Pricing remains hidden unless a business-approved pricing authority is configured.
VITE_ENABLE_LIVE_PRICING=false

# Optional business-approved property rules. Leave blank until approved.
VITE_MINIMUM_SQUARE_FEET=
VITE_MANUAL_QUOTE_ABOVE_SQFT=

# Supabase (add only when a dedicated Tranquility project is provisioned)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key only. Never place secret or service-role keys in VITE_* variables.
VITE_STRIPE_PUBLISHABLE_KEY=
